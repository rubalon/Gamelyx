# MyGamingVault - Git Ignore

#################################################
# IDEs y Editores
#################################################
.vscode/
.idea/
*.swp
*.swo
*~

#################################################
# Sistema Operativo
#################################################
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

#################################################
# Logs
#################################################
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#################################################
# Frontend (Angular 20)
#################################################
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.vscode/
frontend/coverage/
frontend/.nyc_output/
frontend/.cache/
frontend/e2e/
frontend/.sass-cache/

#################################################
# Backend (Spring Boot + Maven)
#################################################
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
backend/*.jar
backend/*.war
backend/*.ear
backend/*.class
backend/.idea/

#################################################
# Base de datos
#################################################
*.db
*.sqlite
*.sqlite3
*.db-journal

#################################################
# Variables de entorno
#################################################
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

#################################################
# Archivos temporales
#################################################
*.tmp
*.temp
.cache/

#################################################
# Claude Code (para el futuro)
#################################################
.claude-code/

#################################################
# Archivos específicos del proyecto
#################################################
# Mantener el workspace pero ignorar configs personales
.vscode/settings.json
!MyGamingVault.code-workspace