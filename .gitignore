# Gamelyx - Git Ignore

#################################################
# IDEs y Editores
#################################################
.vscode/
.idea/
*.swp
*.swo
*~

# Configuraciones de ejecución (contienen variables de entorno)
.run/
*.run.xml
backend/.run/
frontend/.run/

#################################################
# Sistema Operativo
#################################################
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
nul

#################################################
# Logs
#################################################
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#################################################
# Frontend (Angular 20)
#################################################
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.vscode/
frontend/coverage/
frontend/.nyc_output/
frontend/.cache/
frontend/e2e/
frontend/.sass-cache/

#################################################
# Backend (Spring Boot + Maven)
#################################################
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
backend/*.jar
backend/*.war
backend/*.ear
backend/*.class
backend/.idea/

#################################################
# Android/Mobile Build Artifacts
#################################################
*.aab
*.apk
*.keystore
*.jks
/android/app/build/
/android/app/release/

#################################################
# Claves y Certificados de Firmado (CRÍTICO)
#################################################
*-upload-key.keystore
*-release-key.keystore
*-signing-key.keystore
upload-certificate.pem
private_key.pem
*.p12
*.pfx

#################################################
# Base de datos
#################################################
*.db
*.sqlite
*.sqlite3
*.db-journal

#################################################
# Variables de entorno y secretos (CRÍTICO)
#################################################
.env
.env.*
*.env
!.env.example
application-local.properties
application-local.yml
**/secrets/
**/credentials/

#################################################
# Archivos temporales
#################################################
*.tmp
*.temp
.cache/

#################################################
# Claude Code
#################################################
.claude-code/

#################################################
# Archivos específicos del proyecto
#################################################
!Gamelyx.code-workspace