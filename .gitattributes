# Gamelyx - Git Attributes

#################################################
# Auto detect text files and perform LF normalization
#################################################
* text=auto

#################################################
# Maven Wrapper (Backend) - Original from Spring Boot
#################################################
/backend/mvnw text eol=lf
*.cmd text eol=crlf

#################################################
# Java/Spring Boot (Backend)
#################################################
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

#################################################
# TypeScript/Angular (Frontend)  
#################################################
*.ts text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf

#################################################
# Documentation
#################################################
*.md text eol=lf
*.txt text eol=lf

#################################################
# Binary files
#################################################
*.jar binary
*.war binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary